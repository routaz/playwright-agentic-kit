{
  "name": "playwright-agentic-kit",
  "version": "0.1.0",
  "private": true,
  "description": "A Playwright E2E template built for AI agents to plan, write and repair tests from structured app context, with humans reviewing every change.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo": "node examples/demo-app/server.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "context:check": "node kit/context/check.ts",
    "check:leaks": "node scripts/check-leaks.mjs",
    "check": "npm run typecheck && npm run format:check && npm run context:check && npm run test:unit && npm run check:leaks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"kit/**/*.test.ts\"",
    "heal": "node kit/heal/local.ts",
    "coverage": "node kit/observe/coverage.ts",
    "mutate": "node kit/observe/mutate.ts",
    "guide": "node docs/guide/build.mjs",
    "example:supabase": "cd examples/supabase-app && supabase start",
    "example:test": "cd examples/supabase-app && playwright test",
    "example:coverage": "cd examples/supabase-app && node ../../kit/context/check.ts && node ../../kit/observe/coverage.ts",
    "example:mutate": "cd examples/supabase-app && node ../../kit/observe/mutate.ts",
    "demo:capture": "node docs/demo/capture.mjs",
    "demo:build": "node docs/demo/build.mjs",
    "plan": "node kit/author/plan.ts",
    "generate": "node kit/author/generate.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
